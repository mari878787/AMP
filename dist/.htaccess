# ------------------------------------------------------------------------------
# 1. MIME TYPES
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/gif .gif
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType video/mp4 .mp4
</IfModule>

# ------------------------------------------------------------------------------
# 2. CACHE CONTROL & ANTI-CACHE (Ensures newest build is always loaded)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Disable ETags so servers do not serve cached 304s for index.html
  Header unset ETag
  FileETag None

  # ALWAYS serve the latest HTML (never cache index.html)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>

  # Cache static assets
  <FilesMatch "\.(js|mjs|css|webp|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|mp4)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 3. SPA ROUTING (Single Page Application Fallback)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to index.html
  RewriteRule ^index\.html$ - [L]

  # If requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback: Route all other requests to index.html
  RewriteRule . /index.html [L]
</IfModule>
